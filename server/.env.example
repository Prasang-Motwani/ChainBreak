# Copy to .env and fill in. Optional but recommended: raises the GitHub API
# rate limit from 60/hr (unauthenticated) to 5000/hr. Needs no scopes for
# public repositories -- a plain personal access token works.
GITHUB_TOKEN=

# Comma-separated list of deployed frontend origins allowed to call this API
# in production, e.g. https://chainbreak.vercel.app. Leave empty for local
# dev -- localhost is always allowed regardless of this setting.
ALLOWED_ORIGINS=
